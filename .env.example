# Copy this file to `.env` (or set these as environment variables in Render).
# NEVER commit a filled-in .env file.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=placement_db

# Path to CA certificate file when SSL is required (e.g. Aiven/Render free tier)
# Example: DB_CA=db\ca.pem
DB_CA=

# Flask session secret - use a random long string in production
SECRET_KEY=change-me-too